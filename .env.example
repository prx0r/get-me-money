# Controller
GMM_DATA_DIR=/home/YOU/get-me-money/data
GMM_SCAN_INTERVAL_SECONDS=300
GMM_MAX_ATTEMPTS_PER_CYCLE=1
# optional: telegram, discord:#channel, etc after Hermes messaging is configured
GMM_NOTIFY_TARGET=telegram
# optional dashboard bearer auth if proxied remotely
GMM_DASHBOARD_TOKEN=

# Isolated Hermes worker profile: do NOT point at a profile containing marketplace/GitHub/write credentials.
GMM_HERMES_HOME=/home/YOU/.hermes-gmm
HERMES_PROVIDER=nous
# HERMES_MODEL=your-model
HERMES_MAX_TURNS=120
HERMES_TIMEOUT_SECONDS=1800
# Only if your inference provider truly requires an env var instead of credentials in HERMES_HOME:
GMM_WORKER_PASSTHROUGH_ENV=

# Superteam: optional discovery initially.
SUPERTEAM_KEY=
SUPERTEAM_TELEGRAM=
# keep 0 until you have verified your target listing flow and public artifact hosting
SUPERTEAM_AUTOSUBMIT=0
